class Animal:
    def __init__(self, name):
        self.name = name

    def speak(self):
        print(f"{self.name} издаёт звук")

class Dog(Animal):
    def speak(self):
        print(f"{self.name} говорит: Гав!")

class Cat(Animal):
    def speak(self):
        print(f"{self.name} говорит: Мяу!")

animal = Animal("Зверь")
dog = Dog("Шарик")
cat = Cat("Мурка")

animal.speak()  
dog.speak()     
cat.speak()   
